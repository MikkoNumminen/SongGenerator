.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Cached stems and analysis -- large, and regenerable from the input.
work/

# Songs in, memes out. Neither belongs in the repo.
input/
output/

# The word clips themselves are the one audio asset worth tracking, and so is
# labels.tsv -- it is generated, but the labelling in it is hand work that
# cannot be regenerated. words.json likewise holds hand-corrected boundaries.
!words/
!words/*.wav
!words/words.json
!words/labels.tsv

# Candidate cuts are pure scratch: regenerable from the scene at any time.
words/candidates/

# Raw chaos bank: 833 clips, regenerable with build_bank --raw
words_chaos/
