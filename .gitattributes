# What GitHub counts as code written here.
#
# The language bar is a claim about what somebody wrote. Two things in this
# repository are produced by a tool and checked in only so the two halves
# cannot drift apart, and counting them flattered the JSON and TypeScript
# figures while saying nothing true about the work.
#
# Nothing is hidden by this. The files stay tracked, reviewed and diffed; they
# are simply not counted as authored code, which is what `linguist-generated`
# means.

# Written by api/tools/dump_openapi.py and api/tools/generate_dtos.py.
# tests/test_contract.py fails if either drifts from the app it came from.
web/src/app/core/contract/openapi.json linguist-generated=true
web/src/app/core/contract/dto.ts       linguist-generated=true

# Lockfiles are resolved dependency graphs rather than anything anybody typed.
web/package-lock.json linguist-generated=true

# The bank's own index: measurements of audio, written by build_bank.
**/words.json          linguist-generated=true
**/standardized.json   linguist-generated=true
