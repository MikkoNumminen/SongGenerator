# The edge's settings. Copy to api/.env and fill in.
#
# api/.env is gitignored: it holds a Google client id and the addresses that
# administer this deployment, and this repository is public.
#
# The environment still wins over this file, so a one-off override on the
# command line stays a one-off override.

# From the Google Cloud console. The same id the site is built with, or no
# token this edge is handed will name it as the audience.
SONGGEN_GOOGLE_CLIENT_ID=

# Always allowed, and the only accounts that may open the Admin Panel. Kept
# out of the database because the panel edits that table.
SONGGEN_ADMIN_EMAILS=

# Seeds the database's allowlist once, the first time this edge ever starts.
# Changing it afterwards does nothing; grant from the Admin Panel instead.
SONGGEN_ALLOWED_EMAILS=

# Where the front end is served from. The browser preflights every call, and
# "*" with credentials is the pairing browsers refuse anyway.
SONGGEN_ALLOWED_ORIGINS=
