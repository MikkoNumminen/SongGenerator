{
  "components": {
    "schemas": {
      "BankReply": {
        "description": "One bank, as `banks.BankInfo` reports it plus the derived verdict.",
        "properties": {
          "built": {
            "title": "Built",
            "type": "boolean"
          },
          "directory": {
            "title": "Directory",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem"
          },
          "standardised": {
            "title": "Standardised",
            "type": "boolean"
          },
          "units": {
            "title": "Units",
            "type": "integer"
          },
          "usable": {
            "title": "Usable",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "directory",
          "built",
          "units",
          "standardised",
          "usable"
        ],
        "title": "BankReply",
        "type": "object"
      },
      "BanksReply": {
        "properties": {
          "any_usable": {
            "title": "Any Usable",
            "type": "boolean"
          },
          "banks": {
            "items": {
              "$ref": "#/components/schemas/BankReply"
            },
            "title": "Banks",
            "type": "array"
          },
          "engines": {
            "items": {
              "type": "string"
            },
            "title": "Engines",
            "type": "array"
          },
          "levels": {
            "items": {
              "type": "string"
            },
            "title": "Levels",
            "type": "array"
          }
        },
        "required": [
          "banks",
          "any_usable",
          "levels",
          "engines"
        ],
        "title": "BanksReply",
        "type": "object"
      },
      "CancelReply": {
        "properties": {
          "cancelled": {
            "title": "Cancelled",
            "type": "boolean"
          }
        },
        "required": [
          "cancelled"
        ],
        "title": "CancelReply",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthReply": {
        "description": "What an unauthenticated caller may learn. Deliberately nothing else.",
        "properties": {
          "auth_configured": {
            "title": "Auth Configured",
            "type": "boolean"
          },
          "busy": {
            "title": "Busy",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "auth_configured",
          "busy"
        ],
        "title": "HealthReply",
        "type": "object"
      },
      "HistoryReply": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobReply"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "HistoryReply",
        "type": "object"
      },
      "JobReply": {
        "description": "A run as reported. Mirrors `jobs.Job` without the arrangement.\n\nThe pasted arrangement can be enormous and nothing renders it back, so it\nstays in the store for re-running rather than riding on every poll.",
        "properties": {
          "bank": {
            "title": "Bank",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "mimicry": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mimicry"
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Dir"
          },
          "percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent"
          },
          "requested_by": {
            "title": "Requested By",
            "type": "string"
          },
          "settled": {
            "title": "Settled",
            "type": "boolean"
          },
          "song": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Song"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          }
        },
        "required": [
          "id",
          "created_at",
          "requested_by",
          "source_url",
          "bank",
          "stage",
          "settled"
        ],
        "title": "JobReply",
        "type": "object"
      },
      "SubmitBody": {
        "description": "A request to make a song.\n\nValidated here as well as in the browser. The browser's validation is for\nthe person typing; this one is because the browser is not the only thing\nthat can post to this.",
        "properties": {
          "arrangement": {
            "anyOf": [
              {
                "maxLength": 1000000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arrangement"
          },
          "bank": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Bank",
            "type": "string"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "mimicry": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mimicry"
          },
          "source_url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "source_url",
          "bank"
        ],
        "title": "SubmitBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SongGenerator edge",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/banks": {
      "get": {
        "operationId": "list_banks_banks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanksReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Banks"
      }
    },
    "/health": {
      "get": {
        "description": "Open by design. Says nothing about songs or who may use this.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/jobs": {
      "get": {
        "operationId": "history_jobs_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "History"
      },
      "post": {
        "operationId": "submit_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit"
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "one_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One"
      }
    },
    "/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancel_jobs__job_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel"
      }
    }
  }
}
