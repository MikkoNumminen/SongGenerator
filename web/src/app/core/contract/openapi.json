          },
          "song": {
            "title": "Song",
            "type": "string"
          }
        },
        "required": [
          "song",
          "bank",
          "name",
          "bytes"
        ],
        "title": "TrackReply",
        "type": "object"
      },
      "UserReply": {
        "properties": {
