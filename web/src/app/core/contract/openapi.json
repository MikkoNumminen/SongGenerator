  "info": {
    "title": "SongGenerator edge",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/access-requests": {
      "get": {
        "operationId": "list_requests_access_requests_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestsReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Requests"
      },
      "post": {
        "description": "Signed in, refused, and asking.\n\nOpen to any account Google will vouch for, because the people who need\nit are by definition not on the list. It grants nothing: it puts a name\nin a queue the owner reads, and asking twice is still one request.",
        "operationId": "ask_for_access_access_requests_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskedReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ask For Access"
      }
    },
    "/access-requests/{email}": {
      "delete": {
        "operationId": "dismiss_access_requests__email__delete",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestsReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Dismiss"
      }
    },
    "/access-requests/{email}/approve": {
      "post": {
        "description": "Let somebody in, with the demo library, and clear their request.\n\nOne route rather than a grant followed by a delete, so a half-finished\napproval cannot leave somebody admitted and still queued, or queued and\nalready admitted.",
        "operationId": "approve_access_requests__email__approve_post",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Approve"
      }
    },
    "/banks": {
      "get": {
        "operationId": "list_banks_banks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanksReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Banks"
      }
    },
    "/health": {
      "get": {
        "description": "Open by design. Says nothing about songs or who may use this.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/invitations": {
      "get": {
        "operationId": "list_invitations_invitations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationsReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Invitations"
      },
      "post": {
        "description": "A link that admits exactly one account, to the demo library.\n\nWhat it grants is not a parameter. A link that could be made to grant\nmore would be a link worth stealing.",
        "operationId": "invite_invitations_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Invite"
      }
    },
    "/invitations/{token}": {
      "delete": {
        "operationId": "withdraw_invitations__token__delete",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationsReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Withdraw"
      }
    },
    "/invitations/{token}/accept": {
      "post": {
        "description": "Redeem an invitation.\n\nThe only route that admits somebody not already on the allowlist, so\nevery other check is kept and only that one is skipped. A real Google\ntoken is still required and still checked for issuer, audience and a\nverified address: the invitation says a stranger may join, not that\nanybody may claim to be anyone.\n\nThe address admitted is the one Google verified, never one the caller\nsupplies, so a link cannot be redeemed on somebody else's behalf.",
        "operationId": "accept_invitations__token__accept_post",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Accept"
      }
    },
    "/jobs": {
      "get": {
        "description": "Runs this caller may see, optionally narrowed to one person.\n\nThe filter is a convenience for somebody who can already see all of\nthem, not a way to see more: it is applied on top of the same check,\nso naming an address you could not otherwise see returns nothing\nrather than that person's runs.",
        "operationId": "history_jobs_get",
