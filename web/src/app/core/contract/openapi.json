        ],
        "title": "RunsVisibilityRequest",
        "type": "object"
      },
      "SubmitBody": {
        "description": "A request to make a song.\n\nValidated here as well as in the browser. The browser's validation is for\nthe person typing; this one is because the browser is not the only thing\nthat can post to this.",
        "properties": {
          "arrangement": {
            "anyOf": [
              {
                "maxLength": 1000000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arrangement"
          },
          "bank": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Bank",
            "type": "string"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "mimicry": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mimicry"
          },
          "source_url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "source_url",
          "bank"
        ],
        "title": "SubmitBody",
        "type": "object"
      },
      "TrackReply": {
        "description": "One playable rendering, addressed by where it sits on disk.",
