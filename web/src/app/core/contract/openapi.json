{
  "components": {
    "schemas": {
      "BankReply": {
        "description": "One bank, as `banks.BankInfo` reports it plus the derived verdict.",
        "properties": {
          "built": {
            "title": "Built",
            "type": "boolean"
          },
          "directory": {
            "title": "Directory",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Problem"
          },
          "standardised": {
            "title": "Standardised",
            "type": "boolean"
          },
          "units": {
            "title": "Units",
            "type": "integer"
          },
          "usable": {
            "title": "Usable",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "directory",
          "built",
          "units",
          "standardised",
          "usable"
        ],
        "title": "BankReply",
        "type": "object"
      },
      "BanksReply": {
        "properties": {
          "any_usable": {
            "title": "Any Usable",
            "type": "boolean"
          },
          "banks": {
            "items": {
              "$ref": "#/components/schemas/BankReply"
            },
            "title": "Banks",
            "type": "array"
          },
          "engines": {
            "items": {
              "type": "string"
            },
            "title": "Engines",
            "type": "array"
          },
          "levels": {
            "items": {
              "type": "string"
            },
            "title": "Levels",
            "type": "array"
          }
        },
        "required": [
          "banks",
          "any_usable",
          "levels",
          "engines"
        ],
        "title": "BanksReply",
        "type": "object"
      },
      "CancelReply": {
        "properties": {
          "cancelled": {
            "title": "Cancelled",
            "type": "boolean"
          }
        },
        "required": [
          "cancelled"
        ],
        "title": "CancelReply",
        "type": "object"
      },
      "FileReply": {
        "description": "One finished rendering, as something to download.",
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "bytes"
        ],
        "title": "FileReply",
        "type": "object"
      },
      "FilesReply": {
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileReply"
            },
            "title": "Files",
            "type": "array"
          }
        },
        "required": [
          "files"
        ],
        "title": "FilesReply",
        "type": "object"
      },
      "GrantRequest": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "GrantRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthReply": {
        "description": "What an unauthenticated caller may learn. Deliberately nothing else.",
        "properties": {
          "auth_configured": {
            "title": "Auth Configured",
            "type": "boolean"
          },
          "busy": {
            "title": "Busy",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "auth_configured",
          "busy"
        ],
        "title": "HealthReply",
        "type": "object"
      },
      "HistoryReply": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobReply"
            },
            "title": "Jobs",
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "title": "HistoryReply",
        "type": "object"
      },
      "JobReply": {
        "description": "A run as reported. Mirrors `jobs.Job` without the arrangement.\n\nThe pasted arrangement can be enormous and nothing renders it back, so it\nstays in the store for re-running rather than riding on every poll.",
        "properties": {
          "bank": {
            "title": "Bank",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "mimicry": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mimicry"
          },
          "output_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Dir"
          },
          "percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent"
          },
          "requested_by": {
            "title": "Requested By",
            "type": "string"
          },
          "settled": {
            "title": "Settled",
            "type": "boolean"
          },
          "song": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Song"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          }
        },
        "required": [
          "id",
          "created_at",
          "requested_by",
          "source_url",
          "bank",
          "stage",
          "settled"
        ],
        "title": "JobReply",
        "type": "object"
      },
      "LibraryReply": {
        "properties": {
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/TrackReply"
            },
            "title": "Tracks",
            "type": "array"
          }
        },
        "required": [
          "tracks"
        ],
        "title": "LibraryReply",
        "type": "object"
      },
      "SubmitBody": {
        "description": "A request to make a song.\n\nValidated here as well as in the browser. The browser's validation is for\nthe person typing; this one is because the browser is not the only thing\nthat can post to this.",
        "properties": {
          "arrangement": {
            "anyOf": [
              {
                "maxLength": 1000000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arrangement"
          },
          "bank": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Bank",
            "type": "string"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "mimicry": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mimicry"
          },
          "source_url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "source_url",
          "bank"
        ],
        "title": "SubmitBody",
        "type": "object"
      },
      "TrackReply": {
        "description": "One playable rendering, addressed by where it sits on disk.",
        "properties": {
          "bank": {
            "title": "Bank",
            "type": "string"
          },
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "song": {
            "title": "Song",
            "type": "string"
          }
        },
        "required": [
          "song",
          "bank",
          "name",
          "bytes"
        ],
        "title": "TrackReply",
        "type": "object"
      },
      "UserReply": {
        "properties": {
          "added_at": {
            "title": "Added At",
            "type": "string"
          },
          "added_by": {
            "title": "Added By",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "is_admin": {
            "title": "Is Admin",
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "added_at",
          "added_by",
          "is_admin"
        ],
        "title": "UserReply",
        "type": "object"
      },
      "UsersReply": {
        "properties": {
          "admins": {
            "items": {
              "type": "string"
            },
            "title": "Admins",
            "type": "array"
          },
          "users": {
            "items": {
              "$ref": "#/components/schemas/UserReply"
            },
            "title": "Users",
            "type": "array"
          }
        },
        "required": [
          "users",
          "admins"
        ],
        "title": "UsersReply",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SongGenerator edge",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/banks": {
      "get": {
        "operationId": "list_banks_banks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanksReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Banks"
      }
    },
    "/health": {
      "get": {
        "description": "Open by design. Says nothing about songs or who may use this.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/jobs": {
      "get": {
        "operationId": "history_jobs_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "History"
      },
      "post": {
        "operationId": "submit_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit"
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "operationId": "one_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One"
      }
    },
    "/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancel_jobs__job_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel"
      }
    },
    "/jobs/{job_id}/files": {
      "get": {
        "operationId": "files_jobs__job_id__files_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilesReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Files"
      }
    },
    "/jobs/{job_id}/files/{name}": {
      "get": {
        "description": "Hand back one rendering.\n\nThe name is matched against the files the job actually produced rather\nthan joined onto a directory. Joining is how this kind of route becomes\na way to read any file on the machine: `..%2f..%2f` and a path outside\nthe output folder. Comparing against a listing cannot leave the folder,\nwhatever the caller sends, so the guard is the shape of the code rather\nthan a check that can be forgotten.",
        "operationId": "one_file_jobs__job_id__files__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One File"
      }
    },
    "/library": {
      "get": {
        "operationId": "library_library_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Library"
      }
    },
    "/library/{song}/{bank}/{name}": {
      "get": {
        "description": "One rendering, to play or to save.\n\nMatched against the listing rather than joined onto a path, for the\nsame reason as the per-job download: joining is how a route like this\nbecomes a way to read any file on the machine.",
        "operationId": "track_library__song___bank___name__get",
        "parameters": [
          {
            "in": "path",
            "name": "song",
            "required": true,
            "schema": {
              "title": "Song",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "bank",
            "required": true,
            "schema": {
              "title": "Bank",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Track"
      }
    },
    "/users": {
      "get": {
        "operationId": "list_users_users_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersReply"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Users"
      },
      "post": {
        "operationId": "grant_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Grant"
      }
    },
    "/users/{email}": {
      "delete": {
        "operationId": "revoke_users__email__delete",
        "parameters": [
          {
            "in": "path",
            "name": "email",
            "required": true,
            "schema": {
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke"
      }
    }
  }
}
