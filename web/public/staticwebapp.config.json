{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,js,json,ico,png,svg,webmanifest}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  }
}
