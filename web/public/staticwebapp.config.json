{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,js,json,ico,png,svg,webmanifest,map,txt}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "frame-ancestors 'none'"
  }
}
