# Copy to ~/.config/songgenerator.env inside WSL and fill in.
#
# None of this is secret. The client id ships in the site's own JavaScript and
# the addresses are public the moment anything is deployed. Keeping them out of
# the repository stops a home machine's address and a list of real people
# living in git history, which is tidiness rather than protection. The
# allowlist is what protects the service.

# The Google client, same id the site is built with.
SONGGEN_GOOGLE_CLIENT_ID=356639811299-p87ppj0rliv1r0hkhuo97l0l2m00dhls.apps.googleusercontent.com

# Who may actually use it. A real Google account absent from this list gets no
# further than no account at all.
SONGGEN_ALLOWED_EMAILS=you@example.com

# Where the site is served from, so the browser is allowed to call this.
# Both the domain it is proxied under and the Azure address it really lives at,
# because either can be open in a tab.
SONGGEN_ALLOWED_ORIGINS=https://mikkonumminen.dev,https://green-bay-0f4fe1d03.7.azurestaticapps.net
