# Copy to ~/.config/songgenerator.env inside WSL and fill in.
#
# None of this is secret in the sense of being a credential: the client id
# ships in the site's own JavaScript, and an origin is public the moment
# anything is deployed. It still does not belong in the file you are reading.
#
# This repository is public. The values on a real machine name a home machine
# that also serves two other things, and list real people by email address.
# Neither is a password, and publishing either is still worse than not. So this
# file carries the shape and the real one lives at ~/.config/songgenerator.env,
# outside the tree.
#
# The allowlist is what actually protects the service. Everything else here is
# about not handing out more than necessary.

# The Google client, same id the site is built with. Shaped like this, from
# the OAuth client's own page in the Google console.
SONGGEN_GOOGLE_CLIENT_ID=000000000000-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com

# Who may actually use it. A real Google account absent from this list gets no
# further than no account at all.
#
# This seeds the allowlist the FIRST time the edge starts against a new
# database, and is then ignored. After that the list lives in the database and
# is managed from the admin panel, so that granting somebody access does not
# mean editing this file and restarting a desktop service. Adding an address
# here later does nothing.
SONGGEN_ALLOWED_EMAILS=you@example.com,someone-else@example.com

# Who may change that list. Always allowed, whatever the list says.
#
# Deliberately not in the database. The panel exists to edit the allowlist, so
# an admin stored there could be removed through the panel, and the only
# account able to undo it would be the one that just lost access. Kept here,
# that cannot happen: the machine's own configuration decides.
SONGGEN_ADMIN_EMAILS=you@example.com

# Where the site is served from, so the browser is allowed to call this.
# Every origin that can have the site open in a tab, comma separated: the Azure
# address it is deployed to, and any domain put in front of it later.
SONGGEN_ALLOWED_ORIGINS=https://your-site.azurestaticapps.net
